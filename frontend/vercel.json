{
  "framework": "vite",
  "installCommand": "npm ci --ignore-scripts",
  "buildCommand": "npx vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": "https://phrame-phr-api.onrender.com/api/v1/$1"
    },
    {
      "source": "/((?!api/|assets/|favicon).*)",
      "destination": "/index.html"
    }
  ]
}
